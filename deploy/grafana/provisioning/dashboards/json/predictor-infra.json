{
  "uid": "predictor-infra",
  "title": "Service and infrastructure",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["predictor", "infra"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Writer lock",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "predictor_writer_lock", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status heartbeat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "predictor_heartbeat", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scrape up",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up", "legendFormat": "{{job}}", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Root disk used ratio",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "instance:node_disk_root_used_ratio", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container memory",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "container_memory_working_set_bytes", "legendFormat": "{{name}}", "refId": "A"}]
    }
  ]
}
