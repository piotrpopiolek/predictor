# Copy to `.env` on the host that runs this environment. Do not commit `.env`.
# Compose refuses to start when a required value below is empty.

# --- required, no defaults in git ---
API_SPORTS_KEY=
API_SPORTS_BASE_URL=
POSTGRES_SUPERUSER_PASSWORD=
PREDICTOR_APP_PASSWORD=
PREDICTOR_DEV_PASSWORD=
PROMETHEUS_METRICS_TOKEN=
OPERATOR_BET_TOKEN=

# --- cluster / app ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QUOTA_DAILY_LIMIT=75000
QUOTA_SAFETY_BUFFER_PERCENT=0.1
QUOTA_REQUESTS_PER_MINUTE=450
INSTANCE_ID=local-1
HOST_ENVIRONMENT=local
LIVE_POLL_TARGET_SECONDS=60

# --- observability (required for --profile observability / up-prod) ---
# Must be 127.0.0.1 (empty becomes 0.0.0.0 and is forbidden).
OBSERVABILITY_BIND_ADDR=127.0.0.1
# Host ports if 3000/9090/9093 are already taken on this machine.
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Database shown on the tables dashboard. Local stack: predictor_dev. VPS: predictor_prod.
PREDICTOR_METRICS_DB=predictor_prod
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- production image tag (Dockerfile.prod, no bind-mount) ---
PREDICTOR_IMAGE_TAG=v0.1.0

# --- advisor process only; worker and status do not read these ---
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_PRICE_INPUT_PLN_PER_MTOK=
LLM_PRICE_OUTPUT_PLN_PER_MTOK=
ADVISOR_DAILY_BUDGET_PLN=10
ADVISOR_DEBOUNCE_SECONDS=20
# Recommendation stays inactive until stake, loss limit and hours are set.
# Empty ADVISOR_RECOMMENDATION_LEAGUES = every league except untracked_leagues.
# ADVISOR_RECOMMENDATION_STAKE=20
# ADVISOR_RECOMMENDATION_LOSS_LIMIT=100
# ADVISOR_OPERATOR_HOURS=8-22
# ADVISOR_RECOMMENDATION_LEAGUES=39,140
# ADVISOR_RECOMMENDATION_COUPON_LIMIT=10
# ADVISOR_RECOMMENDATION_TTL_SECONDS=180
# ADVISOR_WITHDRAW_YIELD=0
# EU cloud. Empty keys skip the export; decisions still run.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TIMEOUT_SECONDS=5

# --- backup (prod compose). Offsite dir must be outside the production host disk. ---
BACKUP_OFFSITE_CONFIGURED=false
BACKUP_OFFSITE_DIR=
BACKUP_INTERVAL_SECONDS=86400
